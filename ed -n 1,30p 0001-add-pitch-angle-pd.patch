@@
 void AC_AttitudeControl::input_euler_angle_roll_pitch_euler_rate_yaw_rad(float euler_roll_angle_rad, float euler_pitch_angle_rad, float euler_yaw_rate_rads)
 {
     // update attitude target
     update_attitude_target();
 
     // calculate the attitude target euler angles
     _attitude_target.to_euler(_euler_angle_target_rad);
 
     // Add roll trim to compensate tail rotor thrust in heli (will return zero on multirotors)
     euler_roll_angle_rad += get_roll_trim_rad();
 
@@
     } else {
         // When feedforward is not enabled, the target euler angle is input into the target and the feedforward rate is zeroed.
         _euler_angle_target_rad.x = euler_roll_angle_rad;
         _euler_angle_target_rad.y = euler_pitch_angle_rad;
         _euler_angle_target_rad.z += euler_yaw_rate_rads * _dt_s;
         // Compute quaternion target attitude
         _attitude_target.from_euler(_euler_angle_target_rad.x, _euler_angle_target_rad.y, _euler_angle_target_rad.z);
 
         // Set rate feedforward requests to zero
         _euler_rate_target_rads.zero();
         _ang_vel_target_rads.zero();
     }
 
-    // Call quaternion attitude controller
-    attitude_controller_run_quat();
+    //
+    // --- NEW: PD outer-loop for pitch angle (derivative-on-measurement + setpoint-rate feedforward)
+    //
+    // Compute finite-difference setpoint rate for commanded pitch (theta_c_dot)
+    float dt = MAX(1e-6f, _dt_s);
+    float theta_c_dot = (euler_pitch_angle_rad - _theta_cmd_prev) / dt;
+    _theta_cmd_prev = euler_pitch_angle_rad;
+
+    // measured gyro pitch rate (body-frame). get_latest_gyro() returns Vector3f (rad/s), with .y = pitch rate
+    const Vector3f gyro_latest = get_latest_gyro();
+    float gyro_pitch = gyro_latest.y;
+
+    // PT1 filter update for measured gyro pitch rate (simple discrete PT1)
+    // alpha = (2*pi*fD*Ts) / (1 + 2*pi*fD*Ts)
+    float fD = constrain_float(_p_angle_pitch_df, 2.0f, 80.0f);
+    float omega_c_denom = 1.0f + 2.0f * M_PI * fD * dt;
+    float alpha = (2.0f * M_PI * fD * dt) / omega_c_denom;
+    _pit_d_lpf_state += alpha * (gyro_pitch - _pit_d_lpf_state);
+    float q_filt = _pit_d_lpf_state;
+
+    // angle error: use wrap_PI between commanded euler_pitch_angle_rad and current controller target angle
+    float e_theta = wrap_PI(euler_pitch_angle_rad - _euler_angle_target_rad.y);
+
+    // compute P contribution (use existing angle P scaled)
+    const float angleP_pitch = _p_angle_pitch.kP() * _angle_P_scale.y;
+    float p_term = angleP_pitch * e_theta;
+
+    // D contribution using new param _p_angle_pitch_d (dimensionless)
+    float d_term = _p_angle_pitch_d * (theta_c_dot - q_filt);
+
+    // produce body-frame pitch-rate command (rad/s)
+    float omega_c = p_term + d_term;
+
+    // clamp to existing pitch-rate limit
+    float rate_limit = radians(_ang_vel_pitch_max_degs);
+    if (is_positive(_ang_vel_pitch_max_degs)) {
+        omega_c = constrain_float(omega_c, -rate_limit, rate_limit);
+    }
+
+    // overwrite the pitch component of the body-frame angular velocity target:
+    _ang_vel_target_rads.y = omega_c;
+
+    // Log the PD signals for offline analysis (DataFlash). Fields: TimeUS, ThC, Th, ThCd, Qf, E, Ed, Oc, Kp, Kd
+    AP::logger().Write(
+        "APDP", "TimeUS,ThC,Th,ThCd,Qf,E,Ed,Oc,Kp,Kd",
+        "Qfffffffff",
+        AP_HAL::micros64(), (double)euler_pitch_angle_rad, (double)_euler_angle_target_rad.y, (double)theta_c_dot, (double)q_filt,
+        (double)e_theta, (double)(theta_c_dot - q_filt), (double)omega_c, (double)angleP_pitch, (double)_p_angle_pitch_d);
+
+    // Call quaternion attitude controller
+    attitude_controller_run_quat();
 }
 
